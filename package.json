{
  "name": "lean-statusline",
  "version": "1.1.0",
  "description": "statusline for claude code — minimal/compact/full/classic presets, p10k-style configure wizard, node-only, zero deps.",
  "type": "module",
  "bin": {
    "lean-statusline": "./bin/lean-statusline.mjs"
  },
  "main": "./bin/lean-statusline.mjs",
  "exports": {
    ".": "./bin/lean-statusline.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude-code",
    "claude",
    "statusline",
    "prompt",
    "cli",
    "p10k"
  ],
  "author": "Yigit Konur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitkonur/lean-statusline.git"
  },
  "bugs": {
    "url": "https://github.com/yigitkonur/lean-statusline/issues"
  },
  "homepage": "https://github.com/yigitkonur/lean-statusline#readme"
}
